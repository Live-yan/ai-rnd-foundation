FROM python:3.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/
# Pyright needs Node at runtime; preinstall it rather than downloading on every MCP start.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates libatomic1 && rm -rf /var/lib/apt/lists/*
ARG SERENA_REF
RUN test -n "$SERENA_REF" && uv tool install --python /usr/local/bin/python "git+https://github.com/oraios/serena.git@${SERENA_REF}"
ENV PATH=/root/.local/bin:$PATH PYTHONDONTWRITEBYTECODE=1
WORKDIR /template
ENTRYPOINT ["serena"]
CMD ["start-mcp-server", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "9121", "--project", "/template", "--open-web-dashboard", "false"]
