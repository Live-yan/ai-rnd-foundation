FROM node:22-bookworm-slim AS frontend
WORKDIR /web
RUN npm install --global pnpm@9.15.3
COPY frontend/web/ ./
RUN cp .env.production.example .env.production
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
RUN pnpm exec vite build --mode production --base=/web/ && \
    test -s src/types/auto-imports.d.ts && test -s src/types/components.d.ts && \
    pnpm exec vue-tsc --noEmit

FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/
WORKDIR /product/backend
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 ENVIRONMENT=prod
COPY backend/ ./
# Preserve upstream dependency constraints. Lock is resolved only when absent.
RUN if [ -f uv.lock ]; then uv sync --frozen --no-dev; else uv sync --no-dev; fi
COPY --from=frontend /web/dist ./dist
COPY scripts/start_product.sh /start_product.sh
RUN useradd --create-home --uid 10001 app && chown -R app:app /product && chmod 755 /start_product.sh
USER app
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/start_product.sh"]
